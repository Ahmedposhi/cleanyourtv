<?xml version="1.0" encoding="utf-8"?>
<!-- Single shape so clipToOutline gets a real rounded outline (layer-list did not). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#591E2433"
        android:endColor="#4010131B" />
    <stroke
        android:width="1.2dp"
        android:color="#40FFFFFF" />
    <corners android:radius="24dp" />
</shape>
